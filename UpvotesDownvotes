import sqlite3

conn = sqlite3.connect('errorease.db')
cursor = conn.cursor()

#Returns upvotes from solution with the given solutionID
def get_upvotes(cursor, SolutionID):
    cursor.execute("""
            SELECT SOLUTIONS.ErrorCode,
            SOLUTIONS.Upvotes,
            WHERE SOLUTIONS.SolutionID = ?
        """, (SolutionID,))
    
    results = cursor.fetchall()

    if results is None:
        print("Solution ID not found.")
        return None
    
    for row in results:
        print("Error Code:", row[0])
        print("Upvotes:", row[1])

#Returns downvotes from solution with the given solutionID
def get_downvotes(cursor, SolutionID):
    cursor.execute("""
            SELECT SOLUTIONS.ErrorCode,
            SOLUTIONS.Downvotes,
            WHERE SOLUTIONS.SolutionID = ?
        """, (SolutionID,))
    
    results = cursor.fetchall()

    if results is None:
        print("Solution ID not found.")
        return None
    
    for row in results:
        print("Error Code:", row[0])
        print("Downvotes:", row[1])

#increments upvotes from solution with the given solutionID by 1
def increment_upvotes(cursor, SolutionID):
    cursor.execute("""
            UPDATE SOLUTIONS
            SET Upvotes = Upvotes + 1
            WHERE SolutionID = ?
        """, (SolutionID))
    conn.commit()

#increments downvotes from solution with the given solutionID by 1
def increment_downvotes(cursor, SolutionID):
    cursor.execute("""
            UPDATE SOLUTIONS
            SET Downvotes = Downvotes + 1
            WHERE SolutionID = ?
        """, (SolutionID,))
    
    conn.commit()

#Gets total upvotes from solution with the given solutionID by subtracting downvotes from upvotes
def cumulative_upvotes(cursor, SolutionID):
    cursor.execute("""
            SELECT
            COALESCE(Upvotes, 0) - COALESCE(Downvotes, 0) AS total_value
            FROM SOLUTIONS
            WHERE SolutionID = ?
        """, (SolutionID,)) 
    
    result = cursor.fetchone()

    if result is None:
        print("Solution ID not found.")
        return None
    
    print("Cumulative Upvotes:", result[0])

